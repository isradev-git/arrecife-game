  "routes": [
    {
      "from": "apartamento",
      "to": "fiebre",
      "requires": {
        "mission": "retorno_agua",
        "states": [
          "ACTIVE",
          "READY_TO_COMPLETE",
          "COMPLETED"
        ]
      },
      "text": "Cierras la puerta y atraviesas el pasaje. El ruido de los locales llega antes que sus luces."
    },
    {
      "from": "fiebre",
      "to": "apartamento",
      "requires": {},
      "text": "Vuelves por el pasaje hasta tu puerta."
    },
    {
      "from": "fiebre",
      "to": "nudo",
      "requires": {
        "flag": "orden_visita"
      },
      "text": "Descenso por el acceso público."
    },
    {
      "from": "nudo",
      "to": "fiebre",
      "requires": {
        "flag": "acreditacion_residencia"
      },
      "text": "El control comprueba tu acreditación de residencia antes de dejarte subir."
    },
    {
      "from": "nudo",
      "to": "puntales",
      "requires": {
        "flag": "orden_visita"
      },
      "text": "Descenso al acceso de mantenimiento."
